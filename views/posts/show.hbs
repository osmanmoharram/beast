<article class="card">
    <div class="page-head">
        <h1>{{post.title}}</h1>

        {{#if owned}}
            <span class="actions">
                <a class="button button--ghost" href="/posts/{{post.id}}/edit">
                    Edit
                </a>
                <form
                    method="post"
                    action="/posts/{{post.id}}?_method=DELETE"
                    onsubmit="return confirm('Delete this post?')"
                >
                    {{> csrf}}
                    <button class="button--danger" type="submit">Delete</button>
                </form>
            </span>
        {{/if}}
    </div>

    <p class="byline">
        {{post.author.username}} · {{datetime post.createdAt}}
    </p>

    <p class="post-body">{{post.body}}</p>
</article>

<h2 id="comments">Comments <span class="muted">({{commentCount}})</span></h2>

<form class="form-card" method="post" action="/posts/{{post.id}}/comments">
    {{> csrf}}
    <p class="field">
        <label for="body">Add a comment</label>
        <textarea
            id="body"
            name="body"
            minlength="3"
            maxlength="500"
            required
        ></textarea>
    </p>
    <button type="submit">Post comment</button>
</form>

{{#each comments}}
    <div class="comment">
        <div class="comment__body">
            <span class="byline">
                {{this.author.username}} · {{date this.createdAt}}
            </span>
            <p>{{this.body}}</p>

            {{#if this.owned}}
                <form
                    method="post"
                    action="/posts/{{../post.id}}/comments/{{this.id}}?_method=DELETE"
                >
                    {{> csrf}}
                    <button class="button--danger" type="submit">Delete</button>
                </form>
            {{/if}}
        </div>
    </div>
{{else}}
    <p class="state">No comments yet.</p>
{{/each}}

{{> pager}}
